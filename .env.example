# Copy to .env and edit. Every value has a working default — an empty .env is fine.

# --- LLM backend ------------------------------------------------------------
# ollama (default, local, free) or openai
LLM_PROVIDER=ollama

# Model name. Defaults to llama3.1:8b for ollama, gpt-4o-mini for openai.
# Must match a model you have pulled: `ollama list`
LLM_MODEL=llama3.1:8b

# Where Ollama is listening.
OLLAMA_BASE_URL=http://localhost:11434

# Analysts, not chatterboxes. Low temperature, capped output.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# --- OpenAI (only if LLM_PROVIDER=openai) -----------------------------------
# OPENAI_API_KEY=sk-...

# --- Live findings: Tenable (only for --source tenable) ---------------------
# Sent as the header: X-ApiKeys: accessKey=<KEY>; secretKey=<SECRET>
# Create them in Tenable under Settings -> My Account -> API Keys.
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# "io" for Tenable.io (default) or "sc" for Tenable.sc.
TENABLE_FLAVOR=io

# Override only for Tenable.sc or a non-default region.
# TENABLE_URL=https://cloud.tenable.com

# --- Live intel: NVD (only for --live-intel) --------------------------------
# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD throttles to 5 requests/30s; with it, 50.
# CISA KEV and FIRST EPSS need no key at all.
NVD_API_KEY=

# --- Optional ---------------------------------------------------------------
# CrewAI ships telemetry on by default. Uncomment to turn it off.
# CREWAI_DISABLE_TELEMETRY=true
# OTEL_SDK_DISABLED=true
